# ============================================================================
# This repository contains ONLY the Assignment 2 prototype files.
# Everything else (working notes, logs, plans, helper scripts) stays on the
# author's computer and is listed below so it is never committed.
# Patterns are ASCII on purpose: a whitelist at the root level.
# ============================================================================

# 1) ignore everything at the repository root ...
/*
# ... except the public README, this file, the Lab Environment folder, and the demo package
!/README.md
!/.gitignore
!/lab-env/
!/DEMO.ps1
!/DEMO_GUIDE.html
!/DEMO_GUIDE.md
!/PACKAGE_SHA256.json

# 2) the container data volume (created locally by Docker, several hundred MB)
/lab-env/advanced-database-lab/data/

# 3) working documents that are NOT part of the submission
#    (test matrix, report specification, run logs, walkthroughs - kept locally)
/lab-env/advanced-database-lab/workspace/part3_warehouse_etl/*.md
/lab-env/advanced-database-lab/workspace/part5_reports_testing/*.md
/lab-env/advanced-database-lab/workspace/contracts/DATA_CONTRACT_v0_TENTATIVE.md

# 4) official lab exercises / smoke-test leftovers (not our prototype)
/lab-env/advanced-database-lab/workspace/*.sql
/lab-env/advanced-database-lab/workspace/*.py

# 5) local evidence extras: keep one verified end-to-end run + the dashboard data
/lab-env/advanced-database-lab/workspace/evidence/*.txt
/lab-env/advanced-database-lab/workspace/evidence/contributions/
/lab-env/advanced-database-lab/workspace/evidence/sync/
/lab-env/advanced-database-lab/workspace/evidence/e2e_20261001_172735/
/lab-env/advanced-database-lab/workspace/evidence/e2e_20261001_172809/

# 6) local build artefacts
/lab-env/advanced-database-lab/workspace/evidence/dashboard_data/*.tmp

# 7) operating system / editor noise
Thumbs.db
desktop.ini
.DS_Store

# 8) Python bytecode
__pycache__/
*.pyc

# Generated read-only inspection output (full-run evidence is kept)
**/evidence/inspect_*/

# Python bytecode generated locally
*.py[cod]
